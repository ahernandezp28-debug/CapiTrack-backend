// ======================================================
//  Prisma Schema - CapiTrack
//  Gestión de unidades, reportes, combustible, GPS y alertas
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
//  MODELOS BASE
// ======================================================

model Proveedor {
  proveedor_id Int     @id @default(autoincrement())
  nombre       String
  contacto     String?

  unidades Unidad[]

  @@map("proveedores")
}

model Rol {
  rol_id      Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  usuario_id     Int      @id @default(autoincrement())
  nombre         String
  correo         String   @unique
  password       String
  rol_id         Int
  estado         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt
  firebaseUid    String?  @unique

  rol          Rol           @relation(fields: [rol_id], references: [rol_id])
  unidades     Unidad[]      @relation("OperadorUnidad")
  reportes     Reporte[]
  jornadas     Jornada[]
  incidentes   Incidente[]
  combustibles Combustible[]
  servicios    Servicio[]

  @@map("usuarios")
}

// ======================================================
//  MODELOS PRINCIPALES
// ======================================================

model Unidad {
  unidad_id           Int        @id @default(autoincrement())
  nombre              String
  tipo                String      // 👈 OJO: aquí String, ya no enum
  placa               String?
  tipo_combustible    String
  estado              String
  costo_hora Decimal @db.Decimal(10, 2) @default(0)

  proveedor_id        Int
  usuario_operador_id Int?

  proveedor Proveedor? @relation(fields: [proveedor_id], references: [proveedor_id])

  // Relación con Usuario (operador)
  operador  Usuario?   @relation("OperadorUnidad", fields: [usuario_operador_id], references: [usuario_id])

  // Relación con otros módulos
  servicios    Servicio[]
  reportes     Reporte[]
  combustibles Combustible[]
  gps          Gps[]
  alertas      Alerta[]
  incidentes   Incidente[]
  geocercas    Geocerca[]
  jornadas     Jornada[]

  @@map("unidades")
}

model Jornada {
  jornada_id   Int      @id @default(autoincrement())
  fecha        DateTime @default(now())

  unidad_id    Int
  operador_id  Int

  // Para CAMION (tiempo)
  inicio_jornada DateTime?
  fin_jornada    DateTime?

  // Para MAQUINARIA (horómetro)
  horometro_inicio Decimal?
  horometro_fin    Decimal?

  // Común
  total_horas  Decimal?
  costo_hora   Decimal
  total_pagar  Decimal?

  unidad   Unidad  @relation(fields: [unidad_id], references: [unidad_id])
  operador Usuario @relation(fields: [operador_id], references: [usuario_id])

  @@map("jornadas")
}



// ======================================================
//  MÓDULO DE SERVICIOS Y REPORTES
// ======================================================

model Servicio {
  servicio_id Int      @id @default(autoincrement())
  tipo        String
  fecha       DateTime
  descripcion String?
  unidad_id   Int
  usuario_id  Int

  unidad  Unidad  @relation(fields: [unidad_id], references: [unidad_id])
  usuario Usuario @relation(fields: [usuario_id], references: [usuario_id])

  @@map("servicios")
}

model Reporte {
  reporte_id       Int      @id @default(autoincrement())
  tipo             String
  fecha            DateTime
  hora_inicio      DateTime
  hora_fin         DateTime
  horas_trabajadas Float?
  observaciones    String?
  unidad_id        Int
  usuario_id       Int

  unidad  Unidad  @relation(fields: [unidad_id], references: [unidad_id])
  usuario Usuario @relation(fields: [usuario_id], references: [usuario_id])

  @@map("reportes")
}

// ======================================================
//  NUEVOS MODELOS AGREGADOS
// ======================================================

// --- Combustible ---
model Combustible {
  combustible_id Int      @id @default(autoincrement())
  tipo           String
  cantidad       Float
  costo_total    Float?
  fecha_registro DateTime @default(now())
  unidad_id      Int
  usuario_id     Int //

  unidad  Unidad  @relation(fields: [unidad_id], references: [unidad_id])
  usuario Usuario @relation(fields: [usuario_id], references: [usuario_id])

  @@map("combustibles")
}

// --- GPS ---
model Gps {
  gps_id             Int      @id @default(autoincrement())
  latitud            Float
  longitud           Float
  velocidad          Float?
  fecha_registro     DateTime @default(now())
  unidad_id          Int
  ultima_geocerca_id Int?

  unidad Unidad @relation(fields: [unidad_id], references: [unidad_id])

  @@map("gps")
}

// --- Alerta ---
model Alerta {
  alerta_id      Int      @id @default(autoincrement())
  tipo           String
  mensaje        String
  prioridad      String
  fecha_generada DateTime @default(now())
  unidad_id      Int

  unidad Unidad @relation(fields: [unidad_id], references: [unidad_id])

  @@map("alertas")
}




// --- Incidente ---
model Incidente {
  incidente_id Int      @id @default(autoincrement())
  tipo         String
  descripcion  String
  fecha        DateTime @default(now())
  severidad    String
  unidad_id    Int
  usuario_id   Int

  unidad  Unidad  @relation(fields: [unidad_id], references: [unidad_id])
  usuario Usuario @relation(fields: [usuario_id], references: [usuario_id])

  @@map("incidentes")
}

model Geocerca {
  geocerca_id  Int     @id @default(autoincrement())
  nombre       String
  latitud      Float
  longitud     Float
  radio_metros Float
  tipo_evento  String // 'entrada' | 'salida'
  unidad_id    Int
  activa       Boolean @default(true)

  unidad Unidad @relation(fields: [unidad_id], references: [unidad_id])

  @@map("geocercas")
}
